# Farokhi et al. 2023, Fig. 2/Fig. 3: 90 MeV proton, anoxic (0 % O2).
# No /chem/env/scavenger line: pure water, no dissolved O2.
#
# halfBox 20 um -> a 40x40x40 um^3 box (track-length re-run variant of
# beam_farokhi_proton_o2_0pct.in's 10x10x10 um^3 box), to see how primary
# and secondary track-length statistics change as the sensitive volume
# grows beyond the paper's own 10 um box.

/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Ritchie1994

/chem/select Farokhi2023
/chem/meso/enable false
/chem/env/halfBox 20 um

/run/initialize

/scheduler/endTime 1 us

/gun/particle proton
/gun/energy 90 MeV

/run/beamOn 50
/run/dumpDataAndReset
