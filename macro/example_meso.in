# Example: IRT_syn chemistry mode followed by the mesoscopic stage.
#
# Mode: /process/chem/TimeStepModel IRT_syn with /chem/meso/enable true
# (the default with IRT_syn). The particle-based stage runs to the hand-over
# time, then the mesoscopic stage runs to the end time. Set before
# /run/initialize (PreInit). See docs/adr/0008-selectable-chemistry-modes.md.
#
# SMOKE-SIZED: the end time is set to 1 ms after /run/initialize (not the
# 1 s default, which is slow). Remove that line for the full 1 s run.
#
# Run from the build dir (the build copies macro/ there):
#   sim example_meso.in
# Results: <exeDir>/results/Manifest.json (index) and results/sub_01/, sub_02/.
/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Ritchie1994

/process/chem/TimeStepModel IRT_syn
/chem/meso/enable true

# Dissolved O2 at 21 % of a pure-O2 atmosphere (air-equilibrated water).
# Comment out the next line for the pure-water case.
/chem/env/scavenger O2 21 %

/run/initialize

# Smoke-sized end time (see header). Must follow /run/initialize.
/scheduler/endTime 1 ms

/gun/particle e-
/gun/energy 10 keV

# Sub-run 1
/random/setSeeds 12345 67890
/run/beamOn 2
/run/dumpDataAndResetToDir sub_01

# Sub-run 2, different seeds
/random/setSeeds 23456 78901
/run/beamOn 2
/run/dumpDataAndResetToDir sub_02
