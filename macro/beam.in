/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Error

/process/dna/e-SolvationSubType Ritchie1994

# Chemistry time-step model: SBS (project default, also set in PhysicsList).
# DnaChemistryList rejects IRT with a fatal exception; IRT_syn is allowed.
/process/chem/TimeStepModel SBS

# Optional dissolved-O2 bulk scavenger (% of a pure-O2 atmosphere; 0 = anoxic).
# When > 0 the UHDR O2 sub-system is added. Air-equilibrated water ~= 21 %.
#/chem/env/O2 21
#/chem/env/pH 7

/run/initialize

/gun/particle e-
/gun/energy 100 keV

# Species and reactions are defined in code (src/DnaChemistryList.cc).
# The former "/chem/species" and "/chem/reaction/add" blocks were removed:
# "/chem/reaction/UI" resets the shared G4DNAMolecularReactionTable and would
# wipe the class-built reaction set.

/primaryKiller/eLossMin 1 keV # primary is killed if deposited E is greater than this value
/primaryKiller/eLossMax 2 keV # event is aborted if deposited E is greated than this value
/primaryKiller/minKineticE 0 keV # primary min energy below which primary is killed.
/primaryKiller/verbose 0

/run/beamOn 4

/run/beamOn 2
