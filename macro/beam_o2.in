/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Ritchie1994
/process/chem/TimeStepModel SBS

# Dissolved O2 as a bulk scavenger: 21 % of a pure-O2 atmosphere
# (air-equilibrated water). Currently inert -- the O2/acid-base chemistry is
# always active regardless of this value; this command is reserved for a
# future dissolved-O2 supply mechanism.
/chem/env/O2 21
/chem/env/pH 7

/run/initialize

/gun/particle e-
/gun/energy 100 keV

# Species and reactions are defined in code (src/DnaChemistryList.cc).

#/primaryKiller/eLossMin 1 keV
#/primaryKiller/eLossMax 2 keV
#/primaryKiller/minKineticE 0 keV
#/primaryKiller/verbose 0

/run/beamOn 2
