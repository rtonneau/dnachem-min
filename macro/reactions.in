/run/verbose 0
/tracking/verbose 0

# Info level so the "[RunAction] reaction counts written..." line is visible
# (it's silent at the default Error level).
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Ritchie1994

# Chemistry time-step model: SBS (project default, also set in PhysicsList).
/process/chem/TimeStepModel SBS

# Bin the reaction-count output (Reactions.Txt / Reactions_nt_reactions.csv)
# at a fixed 100 ps step, up to the chemistry scheduler's end time (1 us by
# default -> ~10 bins). Must be issued before /run/initialize (PreInit).
# Mutually exclusive with /chem/reaction/timeBinsList; leave both commented
# out to fall back to the built-in 7-edge default table.
/chem/reaction/timeBinsFixed 100 picosecond
#/chem/reaction/timeBinsList 1 10 100 1000 picosecond

/run/outputDir C:\DEV\GEANT4\DATA\260924

/run/initialize

/gun/particle e-
/gun/energy 10 keV

# Species and reactions are defined in code (src/DnaChemistryList.cc).
# The former "/chem/species" and "/chem/reaction/add" blocks were removed:
# "/chem/reaction/UI" resets the shared G4DNAMolecularReactionTable and would
# wipe the class-built reaction set.

/run/beamOn 4
/run/dumpDataAndReset run01_
/run/beamOn 4
/run/dumpDataAndReset run02_
/run/beamOn 4