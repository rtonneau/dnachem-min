# Validation reference macro (o2): current SBS build, PureWater (default Chemistry).
# 10 keV e-, G(1 us) recorded at the end of the chemistry stage.
# N = 1500 events: relative standard error on G(1 us) <= 3 % (measured 2.3 % worst, e_aq) for e_aq, OH, H2O2, H2
# (measured, see validation/reference/sbs_o2/README.md).
/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Error

/random/setSeeds 12345 67890
/process/dna/e-SolvationSubType Ritchie1994
/chem/env/scavenger O2 21 %
/chem/env/pH 7
/run/initialize
/scheduler/endTime 1 us

/gun/particle e-
/gun/energy 10 keV

/run/beamOn 1500
/run/dumpDataAndReset
