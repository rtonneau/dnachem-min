# Farokhi et al. 2023, Fig. 5: 500 keV electron, 21 % O2.
# /primaryKiller/eLossMin 37.5 keV truncates the primary after 7.5 % of the
# 500 keV beam energy (track-length re-run eLossMin-sensitivity variant of
# beam_farokhi_electron_o2_21pct.in's fixed 5 keV / 1 % threshold).

/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Ritchie1994

/chem/select Farokhi2023
/chem/meso/enable false

/chem/env/scavenger O2 218 uM

/run/initialize

/primaryKiller/eLossMin 37.5 keV
/primaryKiller/verbose 0

/scheduler/endTime 1 us

/gun/particle e-
/gun/energy 500 keV

/run/beamOn 250
/run/dumpDataAndReset
