            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude\\hooks\\update-compile-commands.ps1"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
        "C:/DEV/GEANT4/geant4-v11.4.1-source",
        "C:/DEV/GEANT4/geant4-v11.4.1-source/geant4-v11.4.1/examples",
        "C:/DEV/GEANT4/geant4-v11.4.1-kb"
    ],
    "deny": [
        "Edit(C:/DEV/GEANT4/geant4-v11.4.1-source/**)",
        "Write(C:/DEV/GEANT4/geant4-v11.4.1-source/**)"
    ]
  }
}